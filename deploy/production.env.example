# Template for /etc/analekh/production.env on the VM. Copy it there, fill in every CHANGE_ME with
# a long random value (openssl rand -hex 24), and never commit the filled-in file (rule 6).
#   sudo cp deploy/production.env.example /etc/analekh/production.env
#   sudo chmod 640 /etc/analekh/production.env

ENV=prod

# Public address. A host name gets a Let's Encrypt certificate from Caddy. Until the domain is
# bought, <ip-with-dashes>.sslip.io resolves to the VM (130-210-47-140.sslip.io).
SITE_ADDRESS=130-210-47-140.sslip.io
# Browser origins allowed with the session cookie, separated by ";". The app and the API share one
# origin (nginx proxies /api), so this is the site itself.
CORS_ORIGINS=https://130-210-47-140.sslip.io

# PostgreSQL: the image reads POSTGRES_*, the app reads DATABASE_URL (same values).
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=analekh
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@postgres:5432/analekh

# Valkey (Redis-compatible), reached by service name.
REDIS_URL=redis://valkey:6379/0

# MinIO: the server reads MINIO_ROOT_*, the app reads MINIO_ACCESS_KEY / MINIO_SECRET_KEY
# (same values).
MINIO_ROOT_USER=analekh
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=analekh
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=analekh
MINIO_SECURE=false

# Recalculation service: at least 32 random bytes; the API and the service read the same token.
RECALC_URL=http://recalc:8080
RECALC_TOKEN=CHANGE_ME
RECALC_FALLBACK=fail

# Claude (leave empty to run without generated text).
ANTHROPIC_API_KEY=

# Contact address NSE can reach us on (added to the From header of requests).
CONTACT_EMAIL=
