# Design doc 22.3. Copy to .env and fill in; never commit .env.
# 127.0.0.1, not localhost: on Windows `localhost` tries IPv6 first, and after a Docker restart that
# stalled (API: "MinIO is not reachable" with MinIO up; 2-3 s waits). The Docker containers don't
# use these three: docker-compose.yml sets postgres / redis / minio for them.
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/analekh
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin            # local dev only; set real keys when hosted
MINIO_SECRET_KEY=change-me-locally
MINIO_BUCKET=analekh
ANTHROPIC_API_KEY=...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_SMALL_MODEL=claude-haiku-5-5
EMBEDDINGS_PROVIDER=local
FEED_POLL_SECONDS=300
EVENT_FEED_POLL_SECONDS=1800
UNIVERSE_REFRESH_CRON=0 6 * * 1
BACKFILL_PRIORITY=NIFTY500
# No email or URL in USER_AGENT: NSE's CDN stalls such requests. The contact goes in From.
USER_AGENT=Analekh/0.1
CONTACT_EMAIL=you@example.com
IMPORT_DIR=./import
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# smtp://user:password@host:587. Needed for password-reset codes and email alerts.
SMTP_URL=
SMTP_FROM=                             # empty: the user name in SMTP_URL
ALERT_EMAIL_TO=

# Sign-in (defaults live in analekh/config.py; set only what you change)
ENV=dev                                # dev = sign-in OFF (you act as the dev admin); prod = sign-in ON
                                       # (and the cookie is Secure, https only). Unset means prod.
# AUTH_ENABLED=true                    # dev only: try the real sign-in while ENV=dev
CORS_ORIGINS=http://127.0.0.1:5173;https://127.0.0.1:3000
# SESSION_IDLE_HOURS=9
# SESSION_MAX_HOURS=24
# PASSWORD_MIN_LENGTH=15
# LOGIN_PAUSE_AFTER=3
# LOGIN_BLOCK_AFTER=5
# LOGIN_PAUSE_MINUTES=15
# MAX_UPLOAD_CEILING_BYTES=104857600

# Excel bridge (host)
ANALEKH_API=http://127.0.0.1:8000
ANALEKH_TOKEN=                         # make one in Settings > Excel bridge tokens
WATCH_FOLDERS=~/Models;~/OneDrive/Models
SAVE_MODE=versioned
